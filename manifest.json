{
  "manifest_version": 3,
  "name": "Hotstar Ad Muter",
  "version": "1.1",
  "permissions": ["scripting", "storage", "webRequest"],
  "host_permissions": [
    "*://*.hotstar.com/*",
    "*://service.hotstar.com/*"
  ],
  "background": {
    "service_worker": "./background.js"
  },
  "icons": {
   "16": "./icons/16_16.png",
   "32": "./icons/32_32.png",
   "48": "./icons/48_48.png",
   "128": "./icons/128_128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.hotstar.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hotstar Ad Muter"
  }
}
